# mock: 코레일에 접속하지 않고 전체 흐름을 시험합니다.
# playwright: 실제 브라우저를 열어 코레일에 접속합니다.
KTX_AUTOMATION_MODE=mock
KTX_HEADLESS=false
KTX_FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:5173"]
KTX_MANUAL_ACTION_TIMEOUT_SECONDS=300
KTX_BROWSER_TIMEOUT_MS=15000

# 키링을 쓰기 어려운 개발 환경에서만 사용하세요. .env는 Git에 올리지 마세요.
# KTX_ACCOUNT_ID=
# KTX_ACCOUNT_PASSWORD=

